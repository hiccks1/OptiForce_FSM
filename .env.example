# Copy to .env at the repo root. The API, Prisma and seed scripts all read this file.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fsm
REDIS_URL=redis://localhost:6379

# Auth: required, at least 32 random characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Customer portal links (texted/emailed to customers).
PORTAL_BASE_URL=http://localhost:5173
PORTAL_LINK_TTL=7d
# Customer portal accounts: invite link lifetime and signed-in session lifetime.
PORTAL_INVITE_TTL=7d
PORTAL_SESSION_TTL=30d

# Email (customer portal invites). Any SMTP provider; local dev uses Mailpit from
# infra/docker (smtp://localhost:1025, inbox at http://localhost:8025).
# If SMTP_URL is empty, invite links are logged by the API instead of emailed.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="OptiForce <no-reply@optiforce.local>"

# Comma-separated browser origins allowed to call the API (defaults to PORTAL_BASE_URL).
CORS_ORIGINS=http://localhost:5173

# Sales-demo mode: email-only sign-in for seeded users and a fallback demo tenant
# for unauthenticated requests. Keep false anywhere real customer data lives.
DEMO_MODE=false

# Seed: optional password for every seeded user (else they only work in DEMO_MODE).
SEED_USER_PASSWORD=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=
